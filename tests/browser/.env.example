# Settings for the tracked browser QA (tests/browser, tests/stress) and the
# tracked suite (npm test). Copy to tests/browser/.env (gitignored), edit, then
#   set -a; . tests/browser/.env; set +a
#
# Nothing here is a secret, and nothing here may point at production.

# The PostgreSQL server the tests create and drop their own eodt_* databases on.
# A role that may CREATE DATABASE. A disposable server — never production.
TEST_PG_URL=postgres://postgres:postgres@127.0.0.1:5432

# Optional: a Chromium to launch instead of the one
# `npx playwright install --with-deps chromium` downloads for Playwright 1.63.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Optional: loops per stress script; each script documents its own default.
# STRESS_LOOPS=
