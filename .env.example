# ---------------------------------------------------------------------------
# Elite One Desk — environment
# Copy to .env (never commit .env) and fill in before the first migration.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL=postgres://elite_one_desk:change-me@127.0.0.1:5432/elite_one_desk

# Public origin, no trailing slash. Used for canonicals, OG tags and sitemaps.
NEXT_PUBLIC_SITE_URL=https://eliteonedesk.com

# 32+ random bytes. Signs admin session cookies and preview tokens.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=

# Where uploaded media is written. MUST live outside the deployment directory
# so a release never deletes it. The directory must be writable by the app user.
UPLOAD_DIR=/var/www/elite-one-desk/uploads

# First-run owner account. Only read by `npm run db:seed`, and only when no
# user exists yet. Remove these values once the account is created.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=

# Optional: comma-separated extra origins allowed to POST to the admin API
# (leave empty unless the admin is served from another hostname).
ADMIN_ALLOWED_ORIGINS=
